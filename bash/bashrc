run_with_spinner() {
  local msg="$1"
  shift
  local spin=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')

  tput civis 2>/dev/null

  local was_m=0
  [[ $- == *m* ]] && was_m=1
  set +m
  { "$@" & } 2>/dev/null
  local pid=$!
  local i=0

  trap 'kill -9 "$pid" 2>/dev/null; tput cnorm 2>/dev/null; printf "\r\033[K" >&2; return 130' INT TERM

  while kill -0 "$pid" 2>/dev/null; do
    printf "\r\033[K%s %s" "${spin[i]}" "$msg" >&2
    i=$(((i + 1) % ${#spin[@]}))
    sleep 0.1
  done

  wait "$pid" 2>/dev/null
  local exit_code=$?
  trap - INT TERM
  tput cnorm 2>/dev/null
  printf "\r\033[K" >&2
  [ $was_m -eq 1 ] && set -m
  return $exit_code
}

log() {
  local entry="$*"
  if [ -z "$entry" ]; then
    local tmpfile
    tmpfile=$(mktemp --suffix=.md)
    ${VISUAL:-${EDITOR:-nano}} "$tmpfile"
    entry=$(<"$tmpfile")
    rm -f "$tmpfile"
  fi
  if [ -z "$entry" ]; then
    echo "No log entry provided."
    return 1
  fi

  local prompt="Read instructions.md and follow Mode 1 (Task Intake & Updates) to update active.md based on this input: $entry"
  run_with_spinner "Updating tasks with Gemini..." sh -c "cd \"$HOME/repos/it-notes\" && agy --model gemini-3.5-flash --print \"\$1\"" _ "$prompt"

  echo ""
  echo "=== Logged Changes ==="
  (
    cd "$HOME/repos/it-notes" || return
    awk '
      NR == FNR {
        if ($0 ~ /^@@ -[0-9]+(,[0-9]+)? \+[0-9]+(,[0-9]+)? @@/) {
          match($0, /\+[0-9]+(,[0-9]+)?/)
          hunk = substr($0, RSTART+1, RLENGTH-1)
          split(hunk, a, ",")
          start = a[1] + 0
          len = (a[2] != "" ? a[2] + 0 : 1)
          for (i = 0; i < len; i++) {
            changed_lines[start + i] = 1
          }
        }
        next
      }
      {
        if ($0 ~ /^# /) {
          top_header = substr($0, 3)
        } else if ($0 ~ /^## /) {
          if (top_header == "Active Tasks") {
            section_label = "Priority: " substr($0, 4)
          } else {
            section_label = "Daily Log (" substr($0, 4) ")"
          }
        }
        if ($0 ~ /^[ \t]*- \[[ x]\] \*\*/ || $0 ~ /^[ \t]*- \*\*/) {
          current_task = $0
          task_printed = 0
        }
        if (FNR in changed_lines) {
          has_changes = 1
          if (section_label != last_section) {
            if (last_section != "") print ""
            print "[" section_label "]"
            last_section = section_label
          }
          if (current_task != "" && task_printed == 0 && $0 != current_task) {
            print "  " current_task
            task_printed = 1
          }
          if ($0 == current_task) {
            task_printed = 1
          }
          print "  " $0
        }
      }
      END {
        if (!has_changes) {
          print "No task changes recorded."
        }
      }
    ' <(git diff -U0 active.md) active.md
  )
}

cleanup() {
  local prompt="Read instructions.md and execute Mode 2 (SOP Generation & Archiving). Scan active.md for completed tasks (- [x]), generate SOPs in sops/ for tasks with technical notes, and move completed tasks to archive.md."
  run_with_spinner "Archiving tasks and generating SOPs with Gemini..." sh -c "cd \"$HOME/repos/it-notes\" && agy --model gemini-3.5-flash --print \"\$1\"" _ "$prompt"

  echo ""
  echo "New SOPs created/updated:"
  ls -1t "$HOME/repos/it-notes/sops" | head -n 5
}

solve() {
  if [ $# -eq 0 ]; then
    echo "Usage: solve <description of issue>"
    return 1
  fi

  local prompt="Review the markdown files in the sops/ directory. Find the SOP that best matches the issue: '$*'. Output EXACTLY the relative file path and line number of its heading in the format 'filepath:linenumber' (e.g., 'sops/gitlab.md:42'). If no relevant SOP exists, output exactly 'NOT_FOUND'. Do not output conversational text or markdown code blocks."

  # Capture the AI output and strip whitespace/newlines
  local result
  result=$(run_with_spinner "Searching SOPs with Gemini..." sh -c "cd \"$HOME/repos/it-notes\" && echo \"\$1\" | agy --model gemini-3.1-pro" _ "$prompt" | tr -d '`\r' | xargs)

  # Check if AI failed to find a match
  if [[ "$result" == *"NOT_FOUND"* ]] || [[ -z "$result" ]]; then
    echo "No matching SOP found."
    return 1
  fi

  # Parse the filepath and line number
  local file="${result%%:*}"
  local line="${result##*:}"
  local full_path="$HOME/repos/it-notes/$file"

  # Verify the file exists and line is numeric before launching neovim
  if [[ -f "$full_path" && "$line" =~ ^[0-9]+$ ]]; then
    nvim "+$line" "$full_path"
  else
    echo "Error parsing AI output. Raw AI Output: $result"
    return 1
  fi
}

importsop() {
  if [ $# -eq 0 ]; then
    echo "Usage: importsop <path/to/file>"
    return 1
  fi
  
  local file_path="$1"
  
  if [ ! -f "$file_path" ]; then
    echo "Error: File '$file_path' not found."
    return 1
  fi
  
  local prompt="Analyze the following reference notes. Improve the formatting, clarity, and structure to create a professional step-by-step SOP. Identify the broad IT system or category. Locate a file in the sops/ directory named after that category (e.g., sops/networking.md). If it does not exist, create it. Append the improved SOP to the bottom of that file under a new '## [Procedure Name]' heading. Notes to process:\n\n$(cat "$file_path")"
  
  run_with_spinner "Generating SOP with Gemini..." sh -c "cd \"$HOME/repos/it-notes\" && agy --model gemini-3.5-flash --print \"\$1\"" _ "$prompt"
  
  echo ""
  echo "File processed and SOP appended."
}

# get current branch in git repo
function parse_git_branch() {
	BRANCH=`git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/'`
	if [ ! "${BRANCH}" == "" ]
	then
		STAT=`parse_git_dirty`
		echo "[${BRANCH}${STAT}]"
	else
		echo ""
	fi
}

# get current status of git repo
function parse_git_dirty {
	status=`git status 2>&1 | tee`
	dirty=`echo -n "${status}" 2> /dev/null | grep "modified:" &> /dev/null; echo "$?"`
	untracked=`echo -n "${status}" 2> /dev/null | grep "Untracked files" &> /dev/null; echo "$?"`
	ahead=`echo -n "${status}" 2> /dev/null | grep "Your branch is ahead of" &> /dev/null; echo "$?"`
	newfile=`echo -n "${status}" 2> /dev/null | grep "new file:" &> /dev/null; echo "$?"`
	renamed=`echo -n "${status}" 2> /dev/null | grep "renamed:" &> /dev/null; echo "$?"`
	deleted=`echo -n "${status}" 2> /dev/null | grep "deleted:" &> /dev/null; echo "$?"`
	bits=''
	if [ "${renamed}" == "0" ]; then
		bits=">${bits}"
	fi
	if [ "${ahead}" == "0" ]; then
		bits="*${bits}"
	fi
	if [ "${newfile}" == "0" ]; then
		bits="+${bits}"
	fi
	if [ "${untracked}" == "0" ]; then
		bits="?${bits}"
	fi
	if [ "${deleted}" == "0" ]; then
		bits="x${bits}"
	fi
	if [ "${dirty}" == "0" ]; then
		bits="!${bits}"
	fi
	if [ ! "${bits}" == "" ]; then
		echo " ${bits}"
	else
		echo ""
	fi
}

# Old prompt
